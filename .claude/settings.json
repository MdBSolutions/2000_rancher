{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"$HOME/.claude/hooks/push-to-develop.sh\"",
            "shell": "bash",
            "statusMessage": "Pushing to develop...",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git *)",
            "command": "bash \"$HOME/.claude/hooks/push-to-develop.sh\"",
            "shell": "bash",
            "statusMessage": "Pushing to develop...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
