* text=auto

# Explicitly declare YAML files as text
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts
*.sh text eol=lf
scripts/* text eol=lf

# Documentation
*.md text eol=lf
README* text eol=lf
CLAUDE.md text eol=lf
AI_CONTEXT.md text eol=lf

# Charts and Helm
Chart.yaml text eol=lf
values.yaml text eol=lf
charts.yaml text eol=lf

# JSON and config
*.json text eol=lf
.env* text eol=lf

# Disable diff for binary files
*.lock binary
